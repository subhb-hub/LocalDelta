                  },
                  "certainty": {
                    "const": "confirmed"
                  }
                }
              },
              "reason": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op_id",
              "action",
              "table",
              "record",
              "source_key",
              "source"
            ],
            "properties": {
              "op_id": {
                "type": "string",
                "format": "uuid"
              },
              "action": {
                "const": "create"
              },
              "table": {
                "const": "snapshots"
              },
              "record": {
                "$ref": "#/$defs/snapshotsRecord"
              },
              "source_key": {
                "type": "string",
                "minLength": 6
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "reference",
                  "certainty"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "manual",
                      "screenshot",
                      "statement",
                      "csv",
                      "other"
                    ]
                  },
                  "reference": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "certainty": {
                    "const": "confirmed"
                  }
                }
              },
              "reason": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op_id",
              "action",
              "table",
              "id",
              "before",
              "changes",
              "reason",
              "source"
            ],
            "properties": {
              "op_id": {
                "type": "string",
                "format": "uuid"
              },
              "action": {
                "const": "correct"
              },
              "table": {
                "enum": [
                  "assets",
                  "transactions",
                  "snapshots"
                ]
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "before": {
                "type": "object",
                "minProperties": 1
              },
              "changes": {
                "type": "object",
                "minProperties": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "reference",
                  "certainty"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "manual",
                      "screenshot",
                      "statement",
                      "csv",
                      "other"
                    ]
                  },
                  "reference": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "certainty": {
                    "const": "confirmed"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op_id",
              "action",
              "table",
              "id",
              "before",
              "reason",
              "source"
            ],
            "properties": {
              "op_id": {
                "type": "string",
                "format": "uuid"
              },
              "action": {
                "const": "void"
              },
              "table": {
                "enum": [
                  "transactions",
                  "snapshots"
                ]
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "before": {
                "type": "object",
                "minProperties": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "reference",
                  "certainty"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "manual",
                      "screenshot",
                      "statement",
                      "csv",
                      "other"
                    ]
                  },
                  "reference": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "certainty": {
                    "const": "confirmed"
