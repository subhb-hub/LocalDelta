{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pdp/1.0/package.schema.json",
  "title": "PDP v1.0 illustrative package schema",
  "description": "Structural validation; canonical hash, cross-field logic, source evidence, foreign keys and CAS are enforced by pdp.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "package_id",
    "database_id",
    "base_revision",
    "schema_fingerprint",
    "base_data_fingerprint",
    "created_at",
    "operations",
    "content_hash"
  ],
  "properties": {
    "protocol": {
      "const": "PDP/1.0"
    },
    "package_id": {
      "type": "string",
      "format": "uuid"
    },
    "database_id": {
      "type": "string",
      "format": "uuid"
    },
    "base_revision": {
      "type": "integer",
      "minimum": 0
    },
    "schema_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "base_data_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^evidence/[^/]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op_id",
              "action",
              "table",
              "record",
              "source_key",
              "source"
            ],
            "properties": {
              "op_id": {
                "type": "string",
                "format": "uuid"
              },
              "action": {
                "const": "create"
              },
              "table": {
                "const": "assets"
              },
              "record": {
                "$ref": "#/$defs/assetsRecord"
              },
              "source_key": {
                "type": "string",
                "minLength": 6
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "reference",
                  "certainty"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "manual",
                      "screenshot",
                      "statement",
                      "csv",
                      "other"
                    ]
                  },
                  "reference": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "certainty": {
                    "const": "confirmed"
                  }
                }
              },
              "reason": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op_id",
              "action",
              "table",
              "record",
              "source_key",
              "source"
            ],
            "properties": {
              "op_id": {
                "type": "string",
                "format": "uuid"
              },
              "action": {
                "const": "create"
              },
              "table": {
                "const": "transactions"
              },
              "record": {
                "$ref": "#/$defs/transactionsRecord"
              },
              "source_key": {
                "type": "string",
                "minLength": 6
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
