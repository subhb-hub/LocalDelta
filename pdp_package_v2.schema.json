{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:localdelta:pdp:2",
  "title": "Portfolio Delta Protocol 2.0 — multi-currency delta",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "package_id", "database_id", "base_revision", "schema_fingerprint", "base_data_fingerprint", "created_at", "operations", "content_hash"],
  "properties": {
    "protocol": {"const": "PDP/2.0"},
    "package_id": {"type": "string", "format": "uuid"},
    "database_id": {"type": "string", "format": "uuid"},
    "base_revision": {"type": "integer", "minimum": 0},
    "schema_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "base_data_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "description": {"type": "string"},
    "evidence": {"type": "array"},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "operations": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["op_id", "action", "table", "source"],
        "properties": {
          "op_id": {"type": "string", "format": "uuid"},
          "action": {"enum": ["create", "correct", "void"]},
          "table": {"enum": ["assets", "transactions", "snapshots", "fx_rates"]},
          "id": {"type": "string", "format": "uuid"},
          "record": {"type": "object"},
          "before": {"type": "object"},
          "changes": {"type": "object"},
          "money": {"$ref": "#/$defs/moneyRoles"},
          "money_before": {"$ref": "#/$defs/moneyRoles"},
          "money_changes": {"$ref": "#/$defs/moneyRoles"},
          "reason": {"type": "string"},
          "source_key": {"type": "string", "minLength": 6},
          "source": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "reference", "certainty"],
            "properties": {
              "kind": {"enum": ["manual", "screenshot", "statement", "csv", "other"]},
              "reference": {"type": "string"},
              "certainty": {"const": "confirmed"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "moneyRoles": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["amount", "currency"],
        "properties": {
          "amount": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
          "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
        }
      }
    }
  }
}
